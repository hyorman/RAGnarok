{
  "name": "ragnarok",
  "displayName": "RAGnarōk - Local RAG for Copilot",
  "description": "Retrieval-Augmented Generation extension for VSCode with local sentence transformers and semantic chunking",
  "version": "0.4.0",
  "workspaces": [
    "packages/core",
    "packages/graph-ui",
    "packages/vscode",
    "packages/mcp-server"
  ],
  "publisher": "hyorman",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyorman/ragnarok"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.105.0"
  },
  "categories": [
    "Machine Learning",
    "Extension Packs",
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "embeddings"
  ],
  "contributes": {
    "configuration": {
      "title": "RAGnarōk",
      "properties": {
        "ragnarok.embeddingBackend": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "**Embedding backend** to use for generating vectors:\n\n- **auto** (default): Try VS Code LM embeddings first; fall back to local HuggingFace if unavailable.\n- **vscodeLM**: Force VS Code Language Model API embeddings. This uses the proposed `embeddings` API, so it requires VS Code Insiders (or another build exposing the proposal), `--enable-proposed-api=hyorman.ragnarok`, and a registered embedding provider such as GitHub Copilot.\n- **huggingface**: Force local HuggingFace Transformers.js embeddings (ONNX/WASM, fully offline).\n\n⚠️ Switching backends may change the embedding dimension. Existing vector stores built with a different backend/model will need to be re-indexed.",
          "enum": [
            "auto",
            "vscodeLM",
            "huggingface"
          ],
          "enumDescriptions": [
            "Auto: Try VS Code LM first, fall back to HuggingFace",
            "VS Code LM: Force VS Code Language Model API embeddings (requires provider)",
            "HuggingFace: Force local Transformers.js embeddings (offline)"
          ],
          "order": 1
        },
        "ragnarok.embeddingVscodeModelId": {
          "type": "string",
          "default": "",
          "markdownDescription": "**VS Code LM embedding model ID** to use when backend is `vscodeLM` or `auto`.\n\nLeave empty to auto-select the first available model. The available models depend on the registered embeddings provider (e.g., GitHub Copilot).\n\n⚠️ This setting only works when the proposed `embeddings` API is enabled for `hyorman.ragnarok`.\n\n💡 Check `Developer: Show Running Extensions` → Language Model API for available model IDs.",
          "order": 1
        },
        "ragnarok.localModelPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a folder containing a locally downloaded Transformers.js-compatible embedding model. Models in this folder appear in the tree view and can be selected directly.",
          "order": 2
        },
        "ragnarok.topK": {
          "type": "number",
          "default": 5,
          "description": "Number of top results to return from RAG queries",
          "minimum": 1,
          "maximum": 20,
          "order": 3
        },
        "ragnarok.chunkSize": {
          "type": "number",
          "default": 1000,
          "description": "Maximum size of text chunks for embedding (in characters)",
          "minimum": 100,
          "maximum": 2000,
          "order": 4
        },
        "ragnarok.chunkOverlap": {
          "type": "number",
          "default": 200,
          "description": "Overlap between chunks (in characters)",
          "minimum": 0,
          "maximum": 500,
          "order": 5
        },
        "ragnarok.logLevel": {
          "type": "string",
          "default": "info",
          "description": "Logging verbosity level for the RAGnarōk output channel",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "enumDescriptions": [
            "Debug: Verbose logging for troubleshooting (most detailed)",
            "Info: Standard informational messages (recommended)",
            "Warn: Only warnings and errors",
            "Error: Only error messages (least verbose)"
          ],
          "order": 6
        },
        "ragnarok.retrievalStrategy": {
          "type": "string",
          "default": "hybrid",
          "markdownDescription": "**Retrieval strategy** for RAG queries:\n\n- **hybrid** (recommended): semantic + keyword\n- **vector**: pure semantic similarity\n- **bm25**: pure keyword search with Okapi BM25 (no embeddings, fast exact matching)\n\n💡 _Can be overridden per query via LM tool parameter_",
          "enum": [
            "vector",
            "hybrid",
            "bm25"
          ],
          "enumDescriptions": [
            "Pure semantic search using embeddings only",
            "Hybrid: Combines semantic + keyword matching (recommended)",
            "BM25: Pure keyword search (Okapi BM25 algorithm, no embeddings needed)"
          ],
          "order": 7
        },
        "ragnarok.maxIterations": {
          "type": "number",
          "default": 3,
          "markdownDescription": "Maximum retrieval iterations. Higher = more thorough but slower.",
          "minimum": 1,
          "maximum": 10,
          "order": 8
        },
        "ragnarok.confidenceThreshold": {
          "type": "number",
          "default": 0.7,
          "markdownDescription": "Confidence threshold (0-1) to stop retrieval. Lower = more iterations, higher = stops earlier.",
          "minimum": 0,
          "maximum": 1,
          "order": 9
        },
        "ragnarok.llmModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "markdownDescription": "**LLM model family** to use for query planning and evaluation.\n\nUse **RAG: Select LLM Model** from the Command Palette to discover all available models at runtime.\n\n💡 The available models depend on your Copilot subscription and installed extensions.",
          "order": 10
        },
        "ragnarok.includeWorkspaceContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Include workspace context:** Pass selected code, active file, imports, and symbols to Copilot (like #codebase).\n\n**Includes:**\n- Selected code (max 1000 chars)\n- File imports and symbols\n- Workspace name\n\n**Privacy:** Only relative paths, no sensitive data",
          "order": 11
        },
        "ragnarok.commonDatabasePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Path to a shared/common RAG database folder.** Topics from this path are read-only and cannot be deleted or modified. Useful for team-shared knowledge bases.\n\n**Format:** Absolute path to a folder containing exported RAG database files.",
          "order": 12
        },
        "ragnarok.rerankerModel": {
          "type": "string",
          "default": "Xenova/ms-marco-MiniLM-L-6-v2",
          "markdownDescription": "**Reranker Model** — The HuggingFace cross-encoder model to use for reranking. Default is `Xenova/ms-marco-MiniLM-L-6-v2` (23MB, fast). Alternatives: `Xenova/ms-marco-MiniLM-L-12-v2` (more accurate), `Xenova/ms-marco-TinyBERT-L-2-v2` (fastest).",
          "order": 13
        },
        "ragnarok.memoryIncludeAuto": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show reserved auto-generated memory entries in memory listings.",
          "order": 17
        },
        "ragnarok.rerankerMaxCandidates": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "markdownDescription": "**Reranker Max Candidates** — Maximum number of candidates to pass through the cross-encoder. Higher values improve recall but increase latency.",
          "order": 14
        },
        "ragnarok.rerankerCandidateMultiplier": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "markdownDescription": "**Reranker Candidate Multiplier** — Over-fetch multiplier for initial retrieval when reranking is enabled. `topK * multiplier` candidates are retrieved before reranking.",
          "order": 15
        }
      }
    },
    "commands": [
      {
        "command": "ragnarok.createTopic",
        "title": "Create New Topic",
        "category": "RAG",
        "icon": "$(add)"
      },
      {
        "command": "ragnarok.deleteTopic",
        "title": "Delete Topic",
        "category": "RAG",
        "icon": "$(trash)"
      },
      {
        "command": "ragnarok.addDocument",
        "title": "Add Document to Topic",
        "category": "RAG",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "ragnarok.addGithubRepo",
        "title": "Add Git Repository to Topic",
        "category": "RAG",
        "icon": "$(github)"
      },
      {
        "command": "ragnarok.addWebUrl",
        "title": "Add Web URL to Topic",
        "category": "RAG",
        "icon": "$(globe)"
      },
      {
        "command": "ragnarok.refreshTopics",
        "title": "Refresh Topics",
        "category": "RAG",
        "icon": "$(refresh)"
      },
      {
        "command": "ragnarok.clearModelCache",
        "title": "Clear Model Cache",
        "category": "RAG"
      },
      {
        "command": "ragnarok.clearDatabase",
        "title": "Clear Database",
        "category": "RAG"
      },
      {
        "command": "ragnarok.addGithubToken",
        "title": "Add GitHub Token",
        "category": "RAG",
        "icon": "$(key)"
      },
      {
        "command": "ragnarok.listGithubTokens",
        "title": "List GitHub Tokens",
        "category": "RAG"
      },
      {
        "command": "ragnarok.removeGithubToken",
        "title": "Remove GitHub Token",
        "category": "RAG",
        "icon": "$(trash)"
      },
      {
        "command": "ragnarok.exportTopic",
        "title": "Export Topic",
        "category": "RAG",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ragnarok.importTopic",
        "title": "Import Topic",
        "category": "RAG",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ragnarok.renameTopic",
        "title": "Rename Topic",
        "category": "RAG",
        "icon": "$(edit)"
      },
      {
        "command": "ragnarok.selectRerankerModel",
        "title": "RAGnarok: Select Reranker Model"
      },
      {
        "command": "ragnarok.showMemoryGraph",
        "title": "RAGnarok: Show Memory Graph",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "ragnarok.resetMemory",
        "title": "Reset Memory",
        "category": "RAG",
        "icon": "$(trash)"
      },
      {
        "command": "ragnarok.refreshMemory",
        "title": "Refresh Memory",
        "category": "RAG",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ragnarok",
          "title": "RAG Topics",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "ragnarok": [
        {
          "id": "ragTopics",
          "name": "Topics",
          "icon": "$(files)"
        },
        {
          "id": "ragMemory",
          "name": "Memory",
          "icon": "$(archive)",
          "type": "tree"
        },
        {
          "id": "ragConfig",
          "name": "Configuration",
          "icon": "$(settings-gear)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ragTopics",
        "contents": "RAGnarōk is starting up...\n\nReady in just a moment.",
        "when": "!ragnarok.loaded"
      },
      {
        "view": "ragTopics",
        "contents": "No topics yet.\n\nCreate a topic to start indexing your documents for semantic search and RAG queries with Copilot.\n\n[$(add) Create Topic](command:ragnarok.createTopic)\n[$(cloud-download) Import Topic](command:ragnarok.importTopic)\n\nNeed help? [Read the docs](https://github.com/hyorman/ragnarok#readme)",
        "when": "ragnarok.loaded && !ragnarok.hasTopics"
      },
      {
        "view": "ragMemory",
        "contents": "No memories stored yet.\nMemories are written through the ragMemory tool in Copilot Chat.\n[$(graph-scatter) Show Memory Graph](command:ragnarok.showMemoryGraph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ragnarok.createTopic",
          "when": "view == ragTopics",
          "group": "navigation@1"
        },
        {
          "command": "ragnarok.importTopic",
          "when": "view == ragTopics",
          "group": "navigation@2"
        },
        {
          "command": "ragnarok.refreshTopics",
          "when": "view == ragTopics",
          "group": "navigation@3"
        },
        {
          "command": "ragnarok.showMemoryGraph",
          "when": "view == ragMemory",
          "group": "navigation@1"
        },
        {
          "command": "ragnarok.refreshMemory",
          "when": "view == ragMemory",
          "group": "navigation@2"
        },
        {
          "command": "ragnarok.resetMemory",
          "when": "view == ragMemory",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ragnarok.addDocument",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@1"
        },
        {
          "command": "ragnarok.addGithubRepo",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@2"
        },
        {
          "command": "ragnarok.addWebUrl",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@3"
        },
        {
          "command": "ragnarok.exportTopic",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@4"
        },
        {
          "command": "ragnarok.deleteTopic",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@5"
        },
        {
          "command": "ragnarok.renameTopic",
          "when": "view == ragTopics && viewItem == topic",
          "group": "inline@6"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "ragQuery",
        "toolReferenceName": "ragQuery",
        "displayName": "RAG Query",
        "modelDescription": "Query an indexed RAG topic to find relevant information. Use it when the user asks about material they have added to RAGnarok. The topic is matched exactly when possible and otherwise by the closest semantic match, reported in the 'topicMatched' field. Complex queries may be answered with multi-step agentic planning.",
        "userDescription": "Search an indexed RAG topic",
        "icon": "$(database)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "documentation",
          "search",
          "copilot",
          "context",
          "rag"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The name of the topic to search within. If no exact match is found, the most semantically similar topic is used."
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "The search query or question to find relevant information"
            },
            "topK": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Number of top results to return. Optional - uses the configured value when omitted."
            },
            "retrievalStrategy": {
              "type": "string",
              "enum": [
                "vector",
                "hybrid",
                "bm25"
              ],
              "description": "Retrieval strategy: 'vector' (semantic only), 'hybrid' (semantic + keyword), or 'bm25' (keyword only). Optional - uses the configured value when omitted."
            }
          },
          "required": [
            "topic",
            "query"
          ]
        }
      },
      {
        "name": "ragMemory",
        "toolReferenceName": "ragMemory",
        "displayName": "RAG Memory",
        "modelDescription": "Store, recall, forget, list, or inspect project memories scoped to the workspace or the current git branch.",
        "userDescription": "Work with project memories",
        "icon": "$(archive)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "memory",
          "context",
          "rag"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "store",
                "recall",
                "forget",
                "stats",
                "list",
                "decay",
                "history",
                "promote",
                "links",
                "communities"
              ],
              "description": "The memory operation to perform"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000,
              "description": "Memory content to store (required for 'store')"
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "description": "Search query (required for 'recall')"
            },
            "topK": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum memories to recall (default 10)"
            },
            "includeEntities": {
              "type": "boolean",
              "description": "Include extracted entities in recall results"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Memory id (used by 'forget', 'history', and 'promote')"
            },
            "olderThan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "Forget memories older than N days"
            },
            "expired": {
              "type": "boolean",
              "description": "Forget expired memories"
            },
            "scope": {
              "type": "string",
              "enum": [
                "workspace",
                "branch"
              ],
              "description": "Memory scope"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Branch name; auto-detected for branch scope when omitted"
            },
            "tags": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": "Tags to attach when storing"
            },
            "ttlDays": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3650,
              "description": "Time to live in days"
            },
            "includeAuto": {
              "type": "boolean",
              "description": "Include reserved automatic memories"
            },
            "reinforce": {
              "type": "boolean",
              "description": "Reinforce recalled memories (turns recall into a mutation)"
            },
            "ids": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "description": "Memory ids to promote"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum memories to list (default 50)"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
        "name": "ragTopic",
        "toolReferenceName": "ragTopic",
        "displayName": "RAG Topics",
        "modelDescription": "List the available RAG topics, or get one topic's statistics and indexed documents. Read-only: creating, renaming, exporting, importing, and deleting topics are user actions in the RAGnarok sidebar.",
        "userDescription": "List RAG topics and inspect one topic",
        "icon": "$(list-tree)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "documentation",
          "search",
          "rag"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "stats"
              ],
              "description": "'list' returns every topic; 'stats' returns one topic's statistics and indexed documents"
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Topic name (required for 'stats')"
            }
          },
          "required": [
            "action"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run build --workspaces && npm run version:sync",
    "migrate:storage": "node packages/core/dist/migrationCli.js migrate",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "compile:tests": "rimraf dist-test && tsc -p ./tsconfig.test.json",
    "compile:tests:all": "npm run compile:tests && npm run compile:tests --workspace=packages/core && npm run compile:tests --workspace=packages/graph-ui && npm run compile:tests --workspace=packages/mcp-server",
    "watch": "tsc -b --watch",
    "watch:tests": "tsc -watch -p ./tsconfig.test.json",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/vscode/test-harness/**/*.ts\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/vscode/test-harness/**/*.ts\" \"*.{json,mjs,md}\"",
    "version:sync": "node scripts/version-sync.js",
    "tools:manifest": "node scripts/generate-tool-manifest.mjs",
    "tools:manifest:check": "node scripts/generate-tool-manifest.mjs --check",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "package:dev": "node scripts/package-dev.js",
    "package": "npm run package:win32-x64 && npm run package:win32-arm64 && npm run package:darwin-x64 && npm run package:darwin-arm64 && npm run package:linux-x64 && npm run package:linux-arm64",
    "package:win32-x64": "node scripts/build-vsix.js win32-x64",
    "package:win32-arm64": "node scripts/build-vsix.js win32-arm64",
    "package:darwin-x64": "node scripts/build-vsix.js darwin-x64",
    "package:darwin-arm64": "node scripts/build-vsix.js darwin-arm64",
    "package:linux-x64": "node scripts/build-vsix.js linux-x64",
    "package:linux-arm64": "node scripts/build-vsix.js linux-arm64",
    "publish:vscode": "node scripts/publish-release.mjs vscode",
    "publish:win32-x64": "node scripts/publish-release.mjs vscode --target=win32-x64",
    "publish:win32-arm64": "node scripts/publish-release.mjs vscode --target=win32-arm64",
    "publish:darwin-x64": "node scripts/publish-release.mjs vscode --target=darwin-x64",
    "publish:darwin-arm64": "node scripts/publish-release.mjs vscode --target=darwin-arm64",
    "publish:linux-x64": "node scripts/publish-release.mjs vscode --target=linux-x64",
    "publish:linux-arm64": "node scripts/publish-release.mjs vscode --target=linux-arm64",
    "pretest": "npm run compile && npm run bundle && npm run compile:tests",
    "test": "node ./dist-test/packages/vscode/test-harness/runTest.js",
    "test:core": "npm test --workspace=packages/core",
    "test:core:compiled": "npm exec --workspace=packages/core mocha",
    "test:vscode:compiled": "node ./dist-test/packages/vscode/test-harness/runTest.js",
    "test:mcp": "npm test --workspace=packages/mcp-server",
    "test:mcp:compiled": "npm exec --workspace=packages/mcp-server mocha",
    "test:graph-ui:compiled": "npm test --workspace=packages/graph-ui",
    "test:all": "npm run compile && npm run bundle && npm run compile:tests:all && npm run test:core:compiled && npm run test:graph-ui:compiled && npm run test:vscode:compiled && npm run test:mcp:compiled",
    "test:fast": "npm run compile && npm run compile:tests:all && npm run test:core:compiled && npm run test:graph-ui:compiled && npm run test:mcp:compiled",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:release-static": "node scripts/test-release-static.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:shutdown-soak": "node scripts/shutdown-soak.mjs",
    "verify:models": "node scripts/verify-model-manifest.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "audit:policy": "node scripts/audit-gate.mjs",
    "release:assets": "node scripts/check-release-assets.mjs",
    "release:verify": "node scripts/release-manifest.mjs verify",
    "bench:beir": "npm run bench:beir --workspace=packages/core",
    "bench:frames": "npm run bench:frames --workspace=packages/core",
    "bench:smoke": "npm run bench:smoke --workspace=packages/core",
    "bench:acquire": "node scripts/acquire-benchmark-corpora.mjs",
    "bench:release": "node scripts/run-release-benchmarks.mjs",
    "bench:update-baseline": "node scripts/update-benchmark-baseline.mjs",
