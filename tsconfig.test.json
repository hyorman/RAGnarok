{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "dist-test",
    "rootDir": ".",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["mocha", "node", "chai"],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@ragnarok/core": ["./packages/core/src/index.ts"],
      "@ragnarok/vscode": ["./packages/vscode/src/index.ts"]
    }
  },
  "include": ["test/**/*.ts", "packages/vscode/test/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
