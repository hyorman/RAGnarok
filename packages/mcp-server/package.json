{
  "name": "@ragnarok/mcp-server",
  "version": "0.4.0",
  "description": "MCP server exposing RAGnarōk tools to any MCP-compatible agent",
  "main": "dist/index.js",
  "bin": {
    "ragnarok-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p ./",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "clean": "rimraf dist dist-test tsconfig.tsbuildinfo",
    "clean:all": "rimraf dist dist-test node_modules tsconfig.tsbuildinfo",
    "clean:tests": "rimraf dist-test",
    "compile:tests": "rimraf dist-test && tsc -p ./tsconfig.test.json",
    "pretest": "npm run compile:tests",
    "test": "mocha",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "prepack": "npm run clean && npm run build",
    "release": "npm publish --access public",
    "docker:build": "docker build -f Dockerfile -t ragnarok-mcp ../../",
    "docker:push": "docker tag ragnarok-mcp hyorman/ragnarok-mcp:latest && docker push hyorman/ragnarok-mcp:latest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@modelcontextprotocol/sdk": "1.28.0",
    "@ragnarok/core": "0.4.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "openai": "4.104.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.0",
    "chai": "^5.1.2",
    "mocha": "^11.0.1",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.2",
    "typescript": "^5.9.3"
  }
}
